# Copie este arquivo para .env e ajuste os valores.
FLASK_APP=wsgi.py
FLASK_DEBUG=1

# Chave usada para assinar sessões e tokens CSRF. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Senha inicial das contas de demonstração. Defina uma senha forte antes do primeiro seed.
DEMO_PASSWORD=

# Banco de dados. Para começar, SQLite (arquivo instance/investsim.db, sem instalar nada).
DATABASE_URL=sqlite:///investsim.db
# PostgreSQL (oficial do projeto): rode database/criar_banco.sql e troque a linha acima por:
# DATABASE_URL=postgresql+psycopg://investsim:investsim@localhost:5432/investsim

FUSO_HORARIO=America/Sao_Paulo

# Por quantos minutos as cotações salvas valem antes de buscar de novo: COTACAO_VALIDADE_MIN
# Dados de mercado:
#   brapi = cotações reais da B3 e de cripto (https://brapi.dev, crie um token gratuito)
#           + CDI oficial do Banco Central
#   demo  = mercado simulado, funciona sem token e sem internet
# Sem FONTE_DADOS: usa brapi se houver BRAPI_TOKEN, senão demo.
BRAPI_TOKEN=
# FONTE_DADOS=demo
COTACAO_VALIDADE_MIN=60
